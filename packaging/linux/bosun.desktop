[Desktop Entry]
Type=Application
Name=Bosun
GenericName=Radio Control
Comment=Control Icom, Yaesu and AOR radios over USB serial or the network
Exec=Bosun
Icon=bosun
Terminal=false
Categories=HamRadio;Network;Utility;
Keywords=radio;ham;cat;civ;scanner;
Actions=Faceplate;

[Desktop Action Faceplate]
Name=Faceplate (touch screen)
Exec=Bosun --faceplate --full-screen
